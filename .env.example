# =============================================================================
# Kawaii Slime Company - Employee Discount & Store Credit
# Environment Configuration (.env.local for local testing / Vercel Environment Variables)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database
# Obtain from: https://supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# 2. Authentication & Session Encryption
# Minimum 32 random characters used to sign HMAC session cookies for dashboard access
# -----------------------------------------------------------------------------
FINANCE_SESSION_SECRET=ksc-employee-discount-secret-super-secure-key-2026

# -----------------------------------------------------------------------------
# 3. Slack App Integration (Webhooks & Welcome DMs)
# Obtain from: https://api.slack.com/apps -> Select App
# Bot Scopes: users:read, users:read.email, chat:write, im:write
# Event Subscriptions: team_join -> pointing to https://<app-domain>/api/webhooks/slack
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# -----------------------------------------------------------------------------
# 4. Shopify Admin GraphQL & REST API Configuration
# Switch between Testing Store and Live Store by updating these 3 variables:
#   Testing Store: e.g. ksc-testing-store.myshopify.com
#   Live Store:    e.g. kawaii-slime-company.myshopify.com
#
# Custom App Setup (Shopify Admin -> Settings -> Apps & Sales Channels -> Develop apps):
# Required Scopes:
#   - write_discounts, read_discounts
#   - write_customers, read_customers
#   - write_store_credit_account_transactions, read_store_credit_accounts
#   - write_price_rules, read_price_rules (optional fallback)
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=kawaii-slime-company.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_access_token_here
SHOPIFY_API_VERSION=2026-01

# -----------------------------------------------------------------------------
# 5. Vercel Cron Secret (Automated Monthly Store Credit Run)
# Sent in 'Authorization: Bearer <CRON_SECRET>' header on the 1st of each month
# -----------------------------------------------------------------------------
CRON_SECRET=ksc-monthly-credit-cron-secret-2026
